BOT_TOKEN=your_bot_token_here
DRIVERS_GROUP_ID=0

# ==========================================
# DATABASE (Neon.tech)
# ==========================================
DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# ==========================================
# BACKEND
# ==========================================
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
SECRET_KEY=change_this_to_random_32_chars_secret

# ==========================================
# COMMISSION RATES (UZS)
# ==========================================
COMMISSION_1_PAX=5000
COMMISSION_2_PAX=8000
COMMISSION_3_PAX=12000
COMMISSION_4_PAX=15000
COMMISSION_5_PLUS_PAX=25000

# ==========================================
# ADMIN PANEL ACCOUNTS (2 ta)
# ==========================================
ADMIN1_USERNAME=admin1
ADMIN1_PASSWORD_HASH=$2b$12$changethis_admin1_bcrypt_hash
ADMIN2_USERNAME=admin2
ADMIN2_PASSWORD_HASH=$2b$12$changethis_admin2_bcrypt_hash
ADMIN_JWT_SECRET=change_this_admin_jwt_secret_key
ADMIN_JWT_EXPIRE_MINUTES=480

# ==========================================
# DEV PANEL ACCOUNTS (2 ta)
# ==========================================
DEV1_USERNAME=dev1
DEV1_PASSWORD_HASH=$2b$12$changethis_dev1_bcrypt_hash
DEV2_USERNAME=dev2
DEV2_PASSWORD_HASH=$2b$12$changethis_dev2_bcrypt_hash
DEV_JWT_SECRET=change_this_dev_jwt_secret_key
DEV_JWT_EXPIRE_MINUTES=240

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/app.log
LOG_RETENTION_DAYS=30

# ==========================================
# KELAJAK (Payment — hozircha bo'sh)
# ==========================================
# PAYME_MERCHANT_ID=
# PAYME_SECRET_KEY=
# CLICK_MERCHANT_ID=
# CLICK_SECRET_KEY=
